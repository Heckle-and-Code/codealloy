#!/usr/bin/env bash
set -euo pipefail

# CodeAlloy CLI Launcher
# Usage:
#   codealloy .                           Open current directory
#   codealloy /path/to/project            Open specific project
#   codealloy --install-extension <path>  Install .vsix package or marketplace extension
#   codealloy --list-extensions           List installed extensions

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec bash "${REPO_ROOT}/scripts/dev.sh" "$@"
