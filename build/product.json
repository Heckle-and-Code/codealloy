{
  "nameShort": "CodeAlloy",
  "nameLong": "CodeAlloy",
  "applicationName": "codealloy",
  "dataFolderName": ".codealloy",
  "win32AppUserModelId": "HeckleAndCode.CodeAlloy",
  "win32MutexName": "codealloy",
  "darwinBundleIdentifier": "com.heckleandcode.codealloy",
  "linuxIconName": "codealloy",
  "licenseName": "MIT",
  "licenseUrl": "https://github.com/Heckle-and-Code/codealloy/blob/main/LICENSE",
  "licenseFileName": "LICENSE.txt",
  "quality": "stable",
  "serverDataFolderName": ".codealloy-remote",
