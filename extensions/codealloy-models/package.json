{
  "name": "codealloy-models",
  "displayName": "CodeAlloy Open Models",
  "description": "Dynamic open model discovery and runtime manager for Ollama, vLLM, and LM Studio",
  "version": "0.1.0",
  "publisher": "codealloy",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codealloy.openWelcome",
        "title": "CodeAlloy: Welcome Walkthrough",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.selectModel",
        "title": "CodeAlloy: Select Active Model",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.refreshModels",
        "title": "CodeAlloy: Refresh Discovered Models",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.configureEndpoint",
        "title": "CodeAlloy: Configure Model Endpoint URL",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.clearChat",
        "title": "CodeAlloy: Clear Agent Chat History",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.focusChat",
        "title": "CodeAlloy: Open / Focus Agent Chat",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.switchProvider",
        "title": "CodeAlloy: Switch Inference Engine Provider",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.selectAutonomy",
        "title": "CodeAlloy: Select Autonomy Level",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.undoLastTurn",
        "title": "CodeAlloy: Undo Last Agent Turn (Rollback)",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.timeTravelTimeline",
        "title": "CodeAlloy: Time-Travel History Scrubber",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.acceptDiffChunk",
        "title": "CodeAlloy: Accept Current Diff Chunk",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.rejectDiffChunk",
        "title": "CodeAlloy: Reject Current Diff Chunk",
        "category": "CodeAlloy"
      },
      {
        "command": "codealloy.acceptAllDiffs",
        "title": "CodeAlloy: Accept All Diff Chunks",
        "category": "CodeAlloy"
      }
    ],
    "keybindings": [
      {
        "command": "codealloy.acceptDiffChunk",
        "key": "tab",
        "when": "codealloy.hasActiveDiff && editorTextFocus"
      },
      {
        "command": "codealloy.rejectDiffChunk",
        "key": "escape",
        "when": "codealloy.hasActiveDiff && editorTextFocus"
      },
      {
        "command": "codealloy.acceptAllDiffs",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "win": "ctrl+enter",
        "linux": "ctrl+enter",
        "when": "codealloy.hasActiveDiff && editorTextFocus"
      }
    ],
    "viewsContainers": {
      "auxiliarybar": [
        {
          "id": "codealloy-agent-panel",
          "title": "CodeAlloy Agent",
          "icon": "$(flame)"
        }
      ]
    },
    "views": {
      "codealloy-agent-panel": [
        {
          "type": "webview",
          "id": "codealloy.agentView",
          "name": "Forge Agent"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "codealloy.welcome",
        "title": "Welcome to CodeAlloy",
        "icon": "resources/anvil-flame.svg",
        "description": "Where developer intent meets open models. Learn how to connect local models and use autonomous coding features.",
        "featuredFor": [
          "*"
        ],
        "steps": [
          {
            "id": "codealloy.about",
            "title": "What is CodeAlloy?",
            "description": "Discover how CodeAlloy brings sovereign, private AI pair programming to local models with zero telemetry.",
            "media": {
              "markdown": "resources/walkthrough/about.md"
            }
          },
          {
            "id": "codealloy.getModels",
            "title": "Getting & Connecting a Model",
            "description": "Run models natively with built-in llama.cpp (Metal GPU), download curated models, or connect external Ollama / vLLM servers.",
            "media": {
              "markdown": "resources/walkthrough/models.md"
            }
          },
          {
            "id": "codealloy.autonomy",
            "title": "The 5-Tier Autonomy Dial",
            "description": "Take full control of agent authority, from passive assistance to supervised diff approvals and autonomous goal loops.",
            "media": {
              "markdown": "resources/walkthrough/autonomy.md"
            }
          },
          {
            "id": "codealloy.changelog",
            "title": "Latest Changelog (v0.1.0-alpha.3)",
            "description": "Explore what's new in the latest release of CodeAlloy.",
            "media": {
              "markdown": "resources/walkthrough/changelog.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "CodeAlloy Models",
      "properties": {
        "codealloy.inferenceProvider": {
          "type": "string",
          "enum": [
            "embedded",
            "external"
          ],
          "enumDescriptions": [
            "Native embedded llama.cpp C++ engine with Apple Silicon Metal GPU acceleration",
            "External or remote inference provider (local Ollama, vLLM, LM Studio, or cloud GPU)"
          ],
          "default": "embedded",
          "description": "Active inference engine provider for CodeAlloy"
        },
        "codealloy.externalEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "External inference provider endpoint URL (e.g. http://127.0.0.1:11434 for Ollama, http://localhost:1234 for LM Studio)"
        },
        "codealloy.model.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Legacy Ollama or OpenAI-compatible endpoint URL"
        },
        "codealloy.model.activeModel": {
          "type": "string",
          "default": "",
          "description": "Currently selected open model for CodeAlloy"
        },
        "codealloy.model.autoDiscover": {
          "type": "boolean",
          "default": true,
          "description": "Automatically discover models on startup and interval"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  }
}
